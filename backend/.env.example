# ─────────────────────────────────────────────────────────────
# ROXY configuration — copy this file to backend/.env
# NEVER commit .env. These values stay server-side only.
# ─────────────────────────────────────────────────────────────

# Generic credentials (used by whichever provider is active)
AI_API_KEY=
AI_API_URL=your_api_endpoint
AI_MODEL=your_model_name

# Active provider: openai | gemini | custom | mock
AI_PROVIDER=gemini

# ── Optional per-provider overrides (fall back to the generic values above)
# OPENAI_API_KEY=sk-...
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# CUSTOM_API_KEY=
# CUSTOM_API_URL=http://localhost:11434/v1/chat/completions
# CUSTOM_MODEL=llama3
# CUSTOM_AUTH_HEADER=Authorization
# CUSTOM_AUTH_PREFIX=Bearer
# CUSTOM_RESPONSE_PATH=choices.0.message.content

# ── Generation
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=512
AI_TIMEOUT=30

# ── Server
HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*

# ── Limits / safety
MAX_MESSAGE_LENGTH=2000
RATE_LIMIT_PER_MINUTE=40
HISTORY_TURNS=12

# ── Memory
MEMORY_ENABLED=true
DB_PATH=backend/data/roxy.sqlite3
MEMORY_CONTEXT_LIMIT=8

# ── Voice
WAKE_WORD=hey roxy
# Server-side TTS: none | openai   (browser speechSynthesis is used when 'none')
TTS_PROVIDER=none
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=nova
# Server-side STT: none | openai
STT_PROVIDER=none
STT_MODEL=whisper-1
